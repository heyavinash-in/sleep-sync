rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    // Public published configuration is read-only for everyone
    match /publishedConfig/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Drafts and config history are admin-only
    match /draftConfig/{document=**} {
      allow read, write: if isAdmin();
    }
    
    match /configHistory/{document=**} {
      allow read, write: if isAdmin();
    }

    // Admin users collection
    match /adminUsers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Only manually added via Firebase Console
    }
  }
}
